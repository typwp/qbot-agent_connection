# ── ACP QQ Bridge 配置模板 ──
# 复制为 .env（放 QQBOT_DIR 或桥目录均可，桥启动时自动加载），按需修改。
# 所有配置均可被环境变量覆盖；缺省值见注释。

# QQ 机器人账号（LLOneBot 登录的 QQ）
BOT_QQ=请填你的机器人QQ

# LLOneBot OneBot11 HTTP 地址（容器/宿主监听端口）
ONEBOT_URL=http://127.0.0.1:3001
ONEBOT_TOKEN=请填LLOneBot的access_token

# 人格：default（内联），或 personas/<名称>.txt 外置人格
BOT_PERSONA=default

# 机器人名称（欢迎语 / 被问"你是什么模型"时的自称；可选，默认 "AI 助手"）
# BOT_NAME=AI 助手

# 群聊名字唤醒词（正则；可选，默认关闭。例：bot名|昵称）
# WAKE_WORDS=

# 数据根目录（user_memories / prefs / reminders / whitelist / .chat-logs 等）
QQBOT_DIR=./data

# 旧 Claude Code 工作目录（pm.js 存读档 / prompt-profiles / vision.js 所在；可选）
# CLAUDE_CWD=/path/to/claude-workspace

# 桥监听端口（LLOneBot 上报目标，需与 LLOneBot 配置的 http-post 一致）
BRIDGE_PORT=3457

# agent 参数（可选）
# ACP_AGENT=claude
# AGENT_TIMEOUT_MS=600000
# MSG_MAX_LEN=4000
# RATE_LIMIT_PER_MIN=10
# MAX_QUEUE=50
